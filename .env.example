# Neon pooled connection string. Keep sslmode=require in deployed environments.
DATABASE_URL=postgresql://user:password@host/database?sslmode=require

# Public canonical origin used for Open Graph metadata after deployment.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Used by later ingest milestones.
FRED_API_KEY=
NYT_API_KEY=
EIA_API_KEY=
BLS_API_KEY=
SEC_USER_AGENT=IndustryScope contact@example.com
